{
  "name": "Fantasy Darts",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance"] }
  },
  "postCreateCommand": "pip install --user -r requirements-dev.txt && python -m app.cli import-season wm2026 || true",
  "postAttachCommand": { "server": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000" },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Fantasy Darts", "onAutoForward": "openPreview" } }
}
