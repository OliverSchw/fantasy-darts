# Kopieren nach .env und anpassen. .env wird nie committet.

# Lokal: weglassen -> SQLite-Datei fantasy.db
# Produktion (Neon): Connection-String aus dem Neon-Dashboard
# DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Zufälliger langer Wert, z.B.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Aktive Saison = Ordnername unter seasons/
SEASON=wm2026

# In Produktion (HTTPS) auf true setzen
SECURE_COOKIES=false

# Optional: Selbst-Registrierung unter /register mit diesem Code erlauben.
# Leer lassen = nur der Admin legt User an.
# INVITE_CODE=bullseye2026

# Zeitzone für Spieltage (Ranking-Bewegung)
# TIMEZONE=Europe/Berlin
